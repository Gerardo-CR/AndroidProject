<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_weight="0.4"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <TextView android:id="@+id/itmTextFechaChildVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView android:id="@+id/itmTextHoraChildVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hora"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_weight="0.3"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView android:id="@+id/itmTextTotalChildVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="total"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_weight="0.3"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pago"
            android:textStyle="bold"
            android:textSize="20sp" />

        <TextView android:id="@+id/itmTextIDChildVenta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="id"
            android:visibility="invisible"/>

        <TextView android:id="@+id/itmTextPagoChildVenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="pago"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>