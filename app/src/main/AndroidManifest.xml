<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gcr.android.inventorytest">

    <uses-feature android:name="android.hardware.camera" />

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="com.gcr.android.inventorytest.MyApplication"
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.gms.vision.DEPENDENCIES"
            android:value="barcode" />

        <activity
            android:name="com.gcr.android.inventorytest.MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="com.gcr.android.inventorytest.Listado_lotes"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.ProductCaptureActivity"
            android:label="@string/action_add_product"
            android:parentActivityName="com.gcr.android.inventorytest.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="androidx.core.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        <activity
            android:name="com.gcr.android.inventorytest.ListadoProductosActivity"
            android:label="@string/inventory"
            android:parentActivityName="com.gcr.android.inventorytest.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="androidx.core.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        <activity
            android:name="com.gcr.android.inventorytest.PuntoVentaActivity"
            android:label="@string/point_sale"
            android:parentActivityName="com.gcr.android.inventorytest.MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="androidx.core.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        <activity
            android:name="com.gcr.android.inventorytest.ListadoVentasActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.DetalleVentaActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.ModificarProductoActivity"
            android:label="@string/update_products"
            android:parentActivityName="com.gcr.android.inventorytest.ListadoProductosActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="androidx.core.PARENT_ACTIVITY"
                android:value=".ListadoProductosActivity" />
        </activity>
        <activity
            android:name="com.gcr.android.inventorytest.SettingsActivity"
            android:label="@string/title_activity_settings"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.Lista_caducidad"
            android:label="Lista de caducidad"
            android:screenOrientation="portrait" />
        <activity android:name="com.gcr.android.inventorytest.Registro" />

        <service android:name="com.gcr.android.inventorytest.fcm.FireMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name="com.gcr.android.inventorytest.NavegadorActivity"
            android:label="SAT"
            android:parentActivityName="com.gcr.android.inventorytest.MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.FCMActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.Estadisticas"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.Autenticar"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.gcr.android.inventorytest.Servicios.Servicio_Fecha_Caducidad"
            android:exported="false" />

        <receiver
            android:name="com.gcr.android.inventorytest.Servicios.Recibir_Fecha_Caducidad"
            android:process=":remote" />

        <activity
            android:name="com.gcr.android.inventorytest.ClientesActivity"
            android:label="Clientes" /> <!-- Vista de clientes por venta -->
        <activity
            android:name="com.gcr.android.inventorytest.DetalleClienteActivity"
            android:label="@string/str_cliente2"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.EditarClienteActivity"
            android:label="@string/str_cliente2"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.gcr.android.inventorytest.DetalleVentaCreditoActivity"
            android:label="@string/str_venta"
            android:screenOrientation="portrait" />

        <service android:name="com.gcr.android.inventorytest.Servicios.Servicio_Ventas_Credito"
            android:exported="false"/>
    </application>

</manifest>