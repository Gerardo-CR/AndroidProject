<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.itsp.android.innovacion2016">

    <uses-feature android:name="android.hardware.camera" />

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.gms.vision.DEPENDENCIES"
            android:value="barcode" />

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".Listado_lotes"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ProductCaptureActivity"
            android:label="@string/action_add_product"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        <activity
            android:name=".ListadoProductosActivity"
            android:label="@string/inventory"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        <activity
            android:name=".PuntoVentaActivity"
            android:label="@string/point_sale"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".MainActivity" />
        </activity>
        <activity
            android:name=".ListadoVentasActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DetalleVentaActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ModificarProductoActivity"
            android:label="@string/update_products"
            android:parentActivityName=".ListadoProductosActivity"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ListadoProductosActivity" />
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:label="@string/title_activity_settings"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Lista_caducidad"
            android:label="Lista de caducidad"
            android:screenOrientation="portrait" />
        <activity android:name=".Registro" />

        <service android:name=".fcm.FireMessagingService">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service android:name=".fcm.FireInstanceIdService">
            <intent-filter>
                <action android:name="com.google.firebase.INSTANCE_ID_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".NavegadorActivity"
            android:label="SAT"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".FCMActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Estadisticas"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Autenticar"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".Servicios.Servicio_Fecha_Caducidad"
            android:exported="false" />

        <receiver
            android:name=".Servicios.Recibir_Fecha_Caducidad"
            android:process=":remote" />

        <activity
            android:name=".ClientesActivity"
            android:label="Clientes" /> <!-- Vista de clientes por venta -->
        <activity
            android:name=".DetalleClienteActivity"
            android:label="@string/str_cliente2"
            android:screenOrientation="portrait" />
        <activity
            android:name=".EditarClienteActivity"
            android:label="@string/str_cliente2"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DetalleVentaCreditoActivity"
            android:label="@string/str_venta"
            android:screenOrientation="portrait" />

        <service android:name=".Servicios.Servicio_Ventas_Credito"
            android:exported="false"/>
    </application>

</manifest>